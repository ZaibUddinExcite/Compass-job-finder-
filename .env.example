# Copy this file to .env and fill in whichever values you're using.

# --- Adzuna (job discovery aggregator) ---
# Free keys: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- AI reader (CV upload + "Read with AI") ---
# Works with any provider — set LLM_PROVIDER to one of:
#   anthropic          -> Claude, e.g. LLM_MODEL=claude-sonnet-4-6
#   openai              -> OpenAI, e.g. LLM_MODEL=gpt-5-mini
#   gemini               -> Google, e.g. LLM_MODEL=gemini-3.1-flash-lite
#   openai-compatible  -> any OpenAI-shaped API: Groq, Mistral, DeepSeek,
#                          OpenRouter, local Ollama, etc — set LLM_BASE_URL too
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Everything above is optional. With nothing set, Adzuna and the AI reader
# are both skipped automatically — Greenhouse/Lever/Ashby discovery and the
# regex-based analysis work fine with zero configuration.
